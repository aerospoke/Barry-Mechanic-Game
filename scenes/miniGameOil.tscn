[sub_resource type="Shader" id="Shader_jqknb"]
code = "shader_type canvas_item;

// fV = fill value
uniform float fV;

// NUEVO: Esto crea un selector de color en el Inspector de Godot
uniform vec4 color_aceite : source_color = vec4(0.65, 0.45, 0.15, 1.0); 

void fragment() {
    vec2 uv = ((UV / -0.10)) + vec2(1.25,1.25);

    float
        sdf=length(uv),c=step(sdf,.85),
        
        vB=smoothstep(.1,.9,sin(uv.x+(PI*.5))-.3),
        vBA=vB*sin(TIME*4.)*.1,
        
        fW=(sin(((TIME*2.)+uv.x)*2.)*.05)+vBA,
        bW=(sin(((TIME*-2.)+uv.x)*2.+PI)*.05)-vBA,
        
        fA=(sin(TIME*4.)*.05)*vB,
        
        fP=fV * 2.3 +(sin((TIME)*PI)*.1) - 1.1,
        
        fF=step(uv.y,(fA+fW)+fP)*c,
        bF=step(uv.y,(-fA+bW)+fP)*c;

    // Guardamos la forma original blanca/gris en una variable
    vec4 forma_original = vec4((step(sdf,1.)-step(sdf,.9))+
        (fF+(clamp(bF-fF,0.,1.)*.8))+
        clamp(pow((sdf+.01)*
        ((1.-(fF+bF))*c),5.),0.,1.));
        
    // Multiplicamos la forma por nuestro color de aceite
    COLOR = forma_original * color_aceite;
} "

